# Copy to server/.env for local overrides. Never commit server/.env.
# Stage 9 needs no secrets. Database and sign-in settings are added in later stages, and production values
# will live only in the hosting provider's environment variables.

# Port for the API and the frontend (same origin).
PORT=3000

# Interface to listen on. 127.0.0.1 keeps the development server private to this computer.
HOST=127.0.0.1

# development | test | production. The transitional /api/v1/state endpoints are disabled in production.
NODE_ENV=development
