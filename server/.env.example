# Copy to server/.env for local overrides. Never commit server/.env.
# Production values live only in the hosting provider's environment variables, never in site/, Git or the browser.

# Port for the API and the frontend (same origin).
PORT=3000

# Interface to listen on. 127.0.0.1 keeps the development server private to this computer.
HOST=127.0.0.1

# development | test | production. The transitional /api/v1/state endpoints and the pre-auth resource API
# (/workspaces, /boards, /records, /imports) are disabled in production.
NODE_ENV=development

# memory (default): Stage 9 in-memory state API only, no database.
# mongodb: use MongoDB through the backend. Requires MONGODB_URI and MONGODB_DB_NAME below.
DATA_STORE=memory

# MongoDB connection string for the JARC-only database user (readWrite on jarc_database only).
# Leave empty here. Put the real value only in server/.env (git-ignored) or the hosting provider's settings.
# Don't put a database name in its path; the database comes from MONGODB_DB_NAME.
MONGODB_URI=

# Must be exactly jarc_database. Any other name (for example another application's database on the shared
# cluster) stops the server at startup.
MONGODB_DB_NAME=jarc_database

# How the resource API knows who is calling.
#   dev   (default outside production) the fixed development user — never available in production.
#   entra Microsoft Entra ID sign-in with server sessions (needs DATA_STORE=mongodb). REQUIRED when
#         NODE_ENV=production; the server refuses to start in production without it and every required ENTRA_* value.
AUTH_MODE=dev

# Microsoft Entra ID (only for AUTH_MODE=entra). Public identifiers of the existing single-page-application (SPA)
# registration, not secrets. No client secret, certificate or API permission is used anywhere.
ENTRA_TENANT_ID=
ENTRA_SPA_CLIENT_ID=
# Must match the SPA registration exactly. Locally: http://localhost:3000/ (not 127.0.0.1). Production: https only.
ENTRA_REDIRECT_URI=
# Optional: the app role (defined on the SPA registration) that makes someone a JARC administrator.
ENTRA_ADMIN_ROLE=JARC.Admin
# Optional: sign-in session lifetime. Ends after this many idle minutes (5–480, default 30) and at most this many
# hours after sign-in (1–24, default 8).
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=8

# Workspace permissions.
#   role_based          (default; also used when this is empty or not exactly one of these values) workspace
#                       memberships and the JARC.Admin app role. Use this for production rollout.
#   development_shared  DEVELOPMENT COLLABORATION: every signed-in employee of ENTRA_TENANT_ID can create workspaces and
#                       manage every workspace, board, column and record. Microsoft sign-in is still required.
ACCESS_POLICY=role_based
